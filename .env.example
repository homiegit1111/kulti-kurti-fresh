# ──────────────────────────────────────────────────────────────────────────────
# Rangat Pehnawa – Environment Variables
# Copy this file to .env.local and fill in your actual values.
# .env.local is git-ignored. NEVER commit real secrets.
#
# Auth boundary (important):
#   • Clerk  = the AUTH provider (sign-in / sign-up / sessions / route protection).
#   • Supabase = DATABASE + customer mapping only (NOT auth/login/OTP).
#   • Shopify = commerce engine (catalog, cart, checkout, orders).
# ──────────────────────────────────────────────────────────────────────────────

# ── Clerk (Authentication) ────────────────────────────────────────────────────
# The real auth layer. Get keys from: Clerk Dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk's custom-styled flows live (match the app's routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# Clerk → app webhook signing secret (svix). Used by /api/webhooks/clerk to
# verify events and provision a matching Shopify customer on sign-up.
# Get from: Clerk Dashboard → Webhooks → your endpoint → Signing Secret.
CLERK_WEBHOOK_SECRET=whsec_...

# ── Supabase (Database / Customer Mapping — NOT auth) ─────────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service Role Key — SERVER-ONLY. Never expose in browser or commit it.
# Required so /api/auth/sync-shopify can write shopify_customer_id back to
# the user record's app_metadata.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Commerce Backend Selection ────────────────────────────────────────────────
# Adapter switch. Leave blank for auto mode:
# Supabase when configured (the primary backend), else legacy Shopify when
# configured, else mock.
# Allowed values: mock, shopify, supabase
NEXT_PUBLIC_COMMERCE_BACKEND=supabase

# The Supabase-backed commerce adapter is the primary backend. It reuses the
# Supabase URL + service-role key configured above (catalog reads/writes, orders,
# checkout, payment reconciliation). No separate commerce server is required.
# Apply supabase/20260709_commerce_backend.sql and
# supabase/20260709_payment_ledgers_generalize.sql, then seed with
# `node scripts/seed-supabase-catalog.mjs`.

# Admin Studio access: comma-separated Clerk user ids. Fail-closed — empty means
# no admin access.
#
# These ids are the BREAK-GLASS OWNER list. They are checked before the database,
# so a bad admin_users row, a half-applied migration, or an accidental
# self-demotion can never lock the store owner out of their own store. Keep at
# least one id here that is NOT managed from inside the admin.
#
# Delegated access (owner / manager / staff) is granted at /admin/team and stored
# in public.admin_users. See docs/ADMIN_STUDIO.md.
ADMIN_CLERK_USER_IDS=

# ── Shopify (Legacy Commerce Backend) ─────────────────────────────────────────
# Your Shopify store domain (no https://, no trailing slash)
# Example: rangat-pehnawa.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API Access Token — SAFE to expose in browser.
# Create in: Shopify Admin → Apps → Develop apps → Your app → API credentials
# → Storefront API access token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_...

# Admin API Access Token — SERVER-ONLY. Never expose in browser.
# Used in /api/auth/sync-shopify and /api/account/orders only.
# Create in: Shopify Admin → Apps → Develop apps → Your app → API credentials
# → Admin API access token (needs Customers: Read/Write + Orders: Read scope)
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_...

# Optional alternative to the Admin token above: OAuth client credentials.
# Only needed if you authenticate the Admin API via client id/secret instead.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Shopify API version (keep updated, current stable: 2026-04)
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-04

# Shopify → app webhook signing secret. Used by /api/webhooks/shopify to verify
# the X-Shopify-Hmac-Sha256 signature and revalidate cached catalog pages.
# Get from: Shopify Admin → Settings → Notifications → Webhooks (or the app's
# webhook subscription), then copy the signing secret.
SHOPIFY_WEBHOOK_SECRET=

# ── Cloudflare Turnstile (Bot Protection) ────────────────────────────────────
# Get from: dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Web Vitals (optional) ─────────────────────────────────────────────────────
# If set, real-user Core Web Vitals are POSTed here from the client reporter.
# Leave blank to disable. Example: /api/vitals or a 3rd-party collector URL.
NEXT_PUBLIC_VITALS_URL=

# ── Google Analytics 4 (optional) ─────────────────────────────────────────────
# GA4 Measurement ID. When set, gtag.js loads with Consent Mode v2 defaulting
# to DENIED — nothing is tracked until the visitor accepts the cookie banner.
# Leave blank to disable analytics entirely. Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Shop Pay express checkout (optional) ──────────────────────────────────────
# Set to "true" ONLY after activating Shop Pay in
# Shopify Admin → Settings → Payments → Shop Pay. When enabled, an express
# "Buy with Shop Pay" button appears in the cart that jumps straight to
# Shopify's hosted checkout (where Shop Pay is the accelerated option).
NEXT_PUBLIC_SHOPIFY_CHECKOUT_ENABLED=
NEXT_PUBLIC_SHOP_PAY_ENABLED=
NEXT_PUBLIC_WHOLESALE_WHATSAPP_NUMBER=

# ── PhonePe (RETIRED — leave empty) ──────────────────────────────────────────
# PhonePe Standard Checkout v2 (OAuth). Retired in favor of Razorpay below;
# routes remain for a possible switch back. Leave these empty in production.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
# Client version from PhonePe (sandbox is typically "1").
PHONEPE_CLIENT_VERSION=1
# "sandbox" (default) or "production" — selects the API hosts.
PHONEPE_ENVIRONMENT=sandbox
# Webhook Basic-auth creds you set in the PhonePe dashboard. The webhook auth
# header is SHA256(username:password); we recompute + compare timing-safe.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ── Razorpay (ACTIVE online checkout gateway) ────────────────────────────────
# Server-only secret; never expose in browser. The checkout page loads
# Razorpay Checkout.js; keyless installs fail closed to a payment-link request.
# PhonePe variables above are retired and must remain empty.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public key id used by Razorpay Checkout.js.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Order completion kill-switch (applies to BOTH gateways). Completion is ON by
# default — a verified+captured payment with a linked order completes it. Set to
# "true" ONLY to temporarily pause automatic completion (payments still verify
# and reconcile; completion is deferred until you unset it).
COMMERCE_ORDER_COMPLETION_DISABLED=
# Long random secret used to bind browser checkout sessions to an order, and as
# the salt for the admin audit log's IP hashes. Unset, no IP is recorded at all
# rather than an unsalted digest of a 32-bit value (which is trivially reversed
# with a list of every IPv4 address).
COMMERCE_CHECKOUT_SESSION_SECRET=

# ── Abandoned-cart recovery (optional) ────────────────────────────────────────
# Shared secret protecting the abandoned-cart cron endpoint
# (/api/cron/abandoned-cart). Generate a long random string. The scheduler must
# send it as `Authorization: Bearer <CRON_SECRET>` or `?secret=<CRON_SECRET>`.
CRON_SECRET=
# Deployed public origin (no trailing slash), e.g. https://rangatpehnawa.com.
# The Cloudflare scheduled() cron worker uses this to call /api/cron/daily on
# itself with the CRON_SECRET bearer. Not needed on Vercel-style platform crons.
APP_ORIGIN=
# Window (minutes) after last cart activity before a cart counts as abandoned.
ABANDONED_CART_THRESHOLD_MINUTES=60
# Resend API key for sending win-back emails. Without it, the sweep logs a
# no-op and leaves carts queued (nothing is sent). Get one at resend.com.
RESEND_API_KEY=
# "From" identity for win-back emails. Must be a domain verified in Resend.
# Defaults to "Rangat Pehnawa <hello@rangatpehnawa.com>" if unset.
ABANDONED_CART_FROM=

# ── Lifecycle emails (optional — share CRON_SECRET + RESEND_API_KEY above) ────
# Default "From" identity for all lifecycle emails (wishlist nudge,
# back-in-stock). Per-kind overrides below win when set.
EMAIL_FROM=
WISHLIST_NUDGE_FROM=
STOCK_ALERT_FROM=
# CAN-SPAM opt-out for lifecycle (marketing) mail. Set at least the mailto so
# every lifecycle email carries a working List-Unsubscribe header. If you also
# set a one-click HTTPS endpoint, Gmail/Yahoo render a native unsubscribe
# button (List-Unsubscribe-Post). Transactional mail (receipts) sends neither.
EMAIL_UNSUBSCRIBE_MAILTO=unsubscribe@rangatpehnawa.com
EMAIL_UNSUBSCRIBE_URL=
# Days a wishlist item must sit before a nudge (default 3), and the minimum
# days between nudges to the same person (default 21).
WISHLIST_NUDGE_DAYS=3
WISHLIST_NUDGE_COOLDOWN_DAYS=21

# ── Sanity CMS (optional — lookbook / editorial) ──────────────────────────────
# Get from: sanity.io → your project → API settings.
# Leave blank to fall back to built-in editorial content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Optional read token (only needed for private datasets / drafts).
SANITY_API_READ_TOKEN=
