# ──────────────────────────────────────────────────────────────────────────────
# Rangat Pehnawa – Environment Variables
# Copy this file to .env.local and fill in your actual values.
# .env.local is git-ignored. NEVER commit real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (Auth / Login / OTP) ─────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service Role Key — SERVER-ONLY. Never expose in browser or commit it.
# Required so /api/auth/sync-shopify can write shopify_customer_id back to
# Supabase user app_metadata.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Shopify (Commerce Backend) ────────────────────────────────────────────────
# Your Shopify store domain (no https://, no trailing slash)
# Example: rangat-pehnawa.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API Access Token — SAFE to expose in browser.
# Create in: Shopify Admin → Apps → Develop apps → Your app → API credentials
# → Storefront API access token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_...

# Admin API Access Token — SERVER-ONLY. Never expose in browser.
# Used in /api/auth/sync-shopify and /api/account/orders only.
# Create in: Shopify Admin → Apps → Develop apps → Your app → API credentials
# → Admin API access token (needs Customers: Read/Write + Orders: Read scope)
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_...

# Shopify API version (keep updated, current stable: 2026-04)
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-04

# ── Cloudflare Turnstile (Bot Protection) ────────────────────────────────────
# Get from: dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
