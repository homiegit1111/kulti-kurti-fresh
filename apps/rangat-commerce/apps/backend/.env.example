# ============================================================================
# Rangat Commerce (Medusa 2.17) — backend environment
# Copy to `.env` for local dev. On Railway set these as service variables.
# ============================================================================

NODE_ENV=production

# --- Datastores -------------------------------------------------------------
# Railway Postgres plugin exposes DATABASE_URL. Locally point at your own PG.
DATABASE_URL=postgres://user:password@localhost:5432/rangat
# Railway Redis plugin exposes REDIS_URL. When set, Medusa uses the Redis
# event bus / workflow engine / cache (required for >1 instance). When blank,
# Medusa falls back to in-memory (single-instance dev only).
REDIS_URL=

# --- Worker mode ------------------------------------------------------------
# server  -> web service (HTTP + admin, no background jobs)
# worker  -> background service (jobs/subscribers, no HTTP)
# shared  -> single process does both (local dev / single instance)
MEDUSA_WORKER_MODE=shared

# --- Secrets (generate strong random values, do NOT reuse the samples) ------
JWT_SECRET=change-me-jwt
COOKIE_SECRET=change-me-cookie

# --- CORS -------------------------------------------------------------------
# Comma-separated origins. STORE = storefront, ADMIN = admin dashboard,
# AUTH = auth callbacks. In prod use the real Vercel + Railway URLs.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# --- Internal storefront->backend link --------------------------------------
# Shared secret the Next.js storefront sends on /store/rangat/customer-link.
# Must match RANGAT_MEDUSA_INTERNAL_SECRET on the storefront side.
RANGAT_MEDUSA_INTERNAL_SECRET=
# Legacy alias, still read as a fallback.
MEDUSA_INTERNAL_API_SECRET=
